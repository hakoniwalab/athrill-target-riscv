diff --git a/boards/aifoundry/erbium/src/init.c b/boards/aifoundry/erbium/src/init.c
index 31f2ce3c5d..1767717335 100644
--- a/boards/aifoundry/erbium/src/init.c
+++ b/boards/aifoundry/erbium/src/init.c
@@ -44,6 +44,8 @@
 
 #include <sys/mount.h>
 #include <syslog.h>
+#include <nuttx/syslog/syslog.h>
+#include <unistd.h>
 
 #include "board_config.h"
 
@@ -57,10 +59,77 @@ __EXPORT void board_on_reset(int status)
 	UNUSED(status);
 }
 
+#if defined(CONFIG_CONSOLE_SYSLOG)
+/* With the console on the syslog (the mavlink variant), the RISC-V common
+ * code does not register the serial driver; register UART0 as /dev/ttyS0. */
+extern void riscv_serialinit(void);
+#endif
+
+#if defined(CONFIG_CONSOLE_SYSLOG) && defined(CONFIG_SYSLOG_REGISTER)
+/*
+ * Athrill only (the mavlink variant): a byte stored at 0x10000000, Athrill's
+ * bring-up output register, goes to Athrill's standard output. No Erbium
+ * hardware has this register. A second syslog channel copies the log there,
+ * so the boot log and later messages also show in the terminal running
+ * Athrill while the UART carries MAVLink.
+ */
+#define ATHRILL_OUTPUT_ADDRESS 0x10000000UL
+
+static int athrill_output_putc(FAR syslog_channel_t *channel, int ch)
+{
+	UNUSED(channel);
+	*(volatile uint8_t *)ATHRILL_OUTPUT_ADDRESS = (uint8_t)ch;
+	return ch;
+}
+
+static ssize_t athrill_output_write(FAR syslog_channel_t *channel, FAR const char *buffer, size_t length)
+{
+	for (size_t i = 0; i < length; i++) {
+		athrill_output_putc(channel, buffer[i]);
+	}
+
+	return length;
+}
+
+static const struct syslog_channel_ops_s athrill_output_ops = {
+	.sc_putc = athrill_output_putc,
+	.sc_force = athrill_output_putc,
+	.sc_write = athrill_output_write,
+	.sc_write_force = athrill_output_write,
+};
+
+static syslog_channel_t athrill_output_channel = {
+	.sc_ops = &athrill_output_ops,
+};
+#endif
+
 __EXPORT int board_app_initialize(uintptr_t arg)
 {
 	UNUSED(arg);
 
+#if defined(CONFIG_CONSOLE_SYSLOG)
+	riscv_serialinit();
+
+#if defined(CONFIG_SYSLOG_REGISTER)
+	syslog_channel_register(&athrill_output_channel);
+#endif
+
+	/* NSH runs the start script and then reads commands from its input, the
+	 * console. The syslog console always reads end of file, so NSH would
+	 * exit, and its exit runs the C++ static destructors - among them the
+	 * parameter layers, which loses the airframe's defaults (no rotors, no
+	 * outputs). This runs in NSH's task before it reads: give it an empty
+	 * pipe as input instead, whose write end stays open, so it waits for
+	 * ever. */
+	int nsh_input[2];
+
+	if (pipe(nsh_input) == 0) {
+		dup2(nsh_input[0], STDIN_FILENO);
+		close(nsh_input[0]);
+	}
+
+#endif
+
 	/* There is no flash storage driver yet: keep parameters and dataman in
 	 * RAM, under CONFIG_BOARD_ROOT_PATH.
 	 */
