+#!/bin/sh
+#
+# AIFoundry Erbium board extras
+#------------------------------------------------------------------------------
+
+# aifoundry_erbium_mavlink: the console is the RAM log (/dev/kmsg) and the only
+# UART carries MAVLink for a ground station.
+if [ -e /dev/kmsg ]
+then
+	mavlink start -d /dev/ttyS0 -b 921600 -r 40000 -x
+fi
diff --git a/boards/aifoundry/erbium/mavlink.px4board b/boards/aifoundry/erbium/mavlink.px4board
new file mode 100644
index 0000000000..317d2f746c
--- /dev/null
+++ b/boards/aifoundry/erbium/mavlink.px4board
@@ -0,0 +1,6 @@
+# MAVLink on the only UART (UART0, /dev/ttyS0) instead of the NSH console,
+# for a ground station such as QGroundControl. The console and the system
+# log go to the RAM log (nuttx-config/mavlink); read it with dmesg from the
+# MAVLink shell. They are also copied to Athrill's bring-up output register
+# (0x10000000), so they show in the terminal running Athrill: this variant
+# is for Athrill only. MAVLink is started by init/rc.board_extras.
